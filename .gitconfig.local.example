[user]
    name = your-name
    email = your-email@example.com

[credential]
    # OSに合わせて選択してください（未設定の場合、資格情報は保存されません）
    # helper = osxkeychain (Mac)
    # helper = manager (Windows)
    # helper = cache (Linux/WSL)

# GitHub限定でgh CLI経由の認証を使う場合（`gh auth login`実行後に有効）
# ghのインストール先に合わせてパスを変更する（mise管理ならshims/ghを指定する）
# [credential "https://github.com"]
#     helper =
#     helper = !~/.local/share/mise/shims/gh auth git-credential
