{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "80",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "500000",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dotfiles/.claude/mods/session-hub:~/dotfiles/.claude/mods/effort-router"
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git stash list)",
      "Bash(git tag *)",
      "Bash(git describe *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(telnet *)",
      "Bash(wget *)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.config/gh/*)",
      "Bash(cat ~/.gnupg/*)",
      "Bash(head ~/.ssh/*)",
      "Bash(head ~/.aws/*)",
      "Bash(head ~/.config/gh/*)",
      "Bash(head ~/.gnupg/*)",
      "Bash(tail ~/.ssh/*)",
      "Bash(tail ~/.aws/*)",
      "Bash(tail ~/.config/gh/*)",
      "Bash(tail ~/.gnupg/*)",
      "Bash(grep * ~/.ssh/*)",
      "Bash(grep * ~/.aws/*)",
      "Bash(grep * ~/.config/gh/*)",
      "Bash(grep * ~/.gnupg/*)",
      "Bash(/root/.ssh/*)",
      "Bash(/root/.aws/*)",
      "Bash(/root/.config/gh/*)",
      "Bash(cat *.pem)",
      "Bash(cat *.key)",
      "Bash(cat *id_rsa*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *_ecdsa*)",
      "Bash(cat *credentials*)",
      "Bash(cat *.env)",
      "Bash(cat *.env.*)",
      "Bash(head *.pem)",
      "Bash(head *.key)",
      "Bash(head *credentials*)",
      "Bash(head *.env)",
      "Bash(head *.env.*)",
      "Bash(tail *.pem)",
      "Bash(tail *.key)",
      "Bash(tail *credentials*)",
      "Bash(tail *.env)",
      "Bash(tail *.env.*)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(export -p)",
      "Bash(curl*-X POST*)",
      "Bash(curl*-X PUT*)",
      "Bash(curl*-X DELETE*)",
      "Bash(curl*-X PATCH*)",
      "Bash(curl*--data*)",
      "Bash(curl* -d *)",
      "Bash(curl*-F *)",
      "Bash(curl* -T *)",
      "Bash(curl*--upload-file*)",
      "Bash(curl*--json*)",
      "Bash(git commit *)",
      "Bash(* git commit *)",
      "Bash(git push *)",
      "Bash(* git push *)",
      "Bash(git merge *)",
      "Bash(* git merge *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git branch -d *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.setenv*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/deepseek/**)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(sed * *.env*)",
      "Bash(awk * *.env*)",
      "Bash(grep * *.env*)",
      "Bash(source *.env*)",
      "Bash(. *.env*)",
      "Bash(cat *setenv*)",
      "Bash(cat ~/.config/deepseek/*)",
      "Bash(printenv *)",
      "Bash(env |*)",
      "Bash(echo *KEY*)",
      "Bash(echo *TOKEN*)",
      "Bash(echo *SECRET*)",
      "Bash(echo *PASSWORD*)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.setenv*)",
      "Read(**/*.key)",
      "Bash(cat **.pem*)",
      "Bash(cat **.p12*)",
      "Bash(cat **.pfx*)",
      "Bash(head **.pem*)",
      "Bash(head **.p12*)",
      "Bash(head **.pfx*)",
      "Bash(head **id_rsa*)",
      "Bash(head **id_ed25519*)",
      "Bash(head **setenv*)",
      "Bash(tail **.pem*)",
      "Bash(tail **.p12*)",
      "Bash(tail **.pfx*)",
      "Bash(tail **id_rsa*)",
      "Bash(tail **id_ed25519*)",
      "Bash(tail **setenv*)",
      "Bash(less **.pem*)",
      "Bash(less **.p12*)",
      "Bash(less **.pfx*)",
      "Bash(less **id_rsa*)",
      "Bash(less **id_ed25519*)",
      "Bash(less **setenv*)",
      "Bash(more **.pem*)",
      "Bash(more **.p12*)",
      "Bash(more **.pfx*)",
      "Bash(more **id_rsa*)",
      "Bash(more **id_ed25519*)",
      "Bash(more **setenv*)",
      "Bash(grep **.pem*)",
      "Bash(grep **.p12*)",
      "Bash(grep **.pfx*)",
      "Bash(grep **id_rsa*)",
      "Bash(grep **id_ed25519*)",
      "Bash(grep **setenv*)",
      "Bash(sed **.pem*)",
      "Bash(sed **.p12*)",
      "Bash(sed **.pfx*)",
      "Bash(sed **id_rsa*)",
      "Bash(sed **id_ed25519*)",
      "Bash(sed **setenv*)",
      "Bash(awk **.pem*)",
      "Bash(awk **.p12*)",
      "Bash(awk **.pfx*)",
      "Bash(awk **id_rsa*)",
      "Bash(awk **id_ed25519*)",
      "Bash(awk **setenv*)",
      "Bash(base64 **.pem*)",
      "Bash(base64 **.p12*)",
      "Bash(base64 **.pfx*)",
      "Bash(base64 **id_rsa*)",
      "Bash(base64 **id_ed25519*)",
      "Bash(base64 **setenv*)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "opusplan",
  "enableAllProjectMcpServers": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-check.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/guard-dangerous-bash.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/takeover.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify-sound.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/tts-speak.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "workflowSizeGuideline": "medium",
  "statusLine": {
    "type": "command",
    "command": "cat | bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "genshijin@genshijin": true,
    "superpowers@superpowers-marketplace": true,
    "dig@kuu-marketplace": true,
    "php-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "kuu-marketplace": {
      "source": {
        "source": "github",
        "repo": "fumiya-kume/claude-code"
      }
    }
  },
  "language": "Japanese",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "fileCheckpointingEnabled": true,
  "showTurnDuration": true,
  "teammateMode": "auto",
  "agentPushNotifEnabled": true,
  "voiceEnabled": true,
  "prStatusFooterEnabled": true,
  "switchModelsOnFlag": false
}
