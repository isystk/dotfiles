#-------------------------
# ローカル環境設定（このファイルを .setenv.local としてコピーし、各値を実際の値に置き換えて使用する）
# .setenv.local は .gitignore 対象（秘密情報を含むためコミットしない）
#-------------------------

# Gemini APIキー
export GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ChatGPT (OpenAI) APIキー
export OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek APIキー（deepseek-worker-ops スキルが使用。https://platform.deepseek.com/api_keys で発行）
export DEEPSEEK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek モデル（未設定時は deepseek-flash。高精度が必要なときのみ deepseek-v4-pro。料金は高くなる）
export DEEPSEEK_MODEL=deepseek-flash

# Wordpress URL
export WORDPRESS_URL=https://blog.example.com/wp-json/wp/v2

# Wordpress APIキー (`echo "<ユーザー名>:<パスワード>" | base64` で生成)
export WORDPRESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# 許可するメールアドレス (Git commiter name/email for Playwright)
export ALLOWED_EMAIL=xxxx@xxxx.com

# run backup push/pull の同期先ディレクトリ（未設定時は /mnt/c/Users/{Windowsユーザー名}/backups）
export BACKUP_DEST=/mnt/c/Users/xxxx/backups

# run ask コマンドでAIに読み込ませたいコンテキスト
export ASK_FILES
typeset -T ASK_FILES ask_files
ask_files=(
  "~/dotfiles/README.md"
  "~/dotfiles/documents/cheatsheet.md"
)
