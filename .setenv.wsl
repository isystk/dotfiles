#-------------------------
# WSL固有の環境設定
#-------------------------

# Neovimをviに設定
export _EDITOR_PATH='nvim'

# Docker Windowsの接続に失敗する時に実行するコマンド
fix_wsl2_interop() {
    for i in $(pstree -np -s $$ | grep -o -E '[0-9]+'); do
        if [[ -e "/run/WSL/${i}_interop" ]]; then
            export WSL_INTEROP=/run/WSL/${i}_interop
        fi
    done
}

# Windowsディレクトリなら git.exe、それ以外はLinuxのgitを実行
function git {
  case $PWD/ in
    /mnt/*|/c/*) git.exe "$@";;
    *) /usr/bin/git "$@";;
  esac
}
