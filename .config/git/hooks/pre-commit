#!/bin/bash

# メールアドレスのチェック
CURRENT_EMAIL=$(git config user.email)
if [ -n "$ALLOWED_EMAIL" ]; then
    if [ "$CURRENT_EMAIL" != "$ALLOWED_EMAIL" ]; then
        echo "❌ Error: 許可されていないメールアドレスです。"
        echo "REQUIRED (env)    => $ALLOWED_EMAIL"
        echo "CURRENT (git)     => $CURRENT_EMAIL"
        exit 1
    fi
fi

# 1. git-secrets を実行
if command -v git-secrets >/dev/null 2>&1; then
    git secrets --pre_commit_hook -- "$@"
    cmdstatus=$?
    if [ $cmdstatus -ne 0 ]; then
        exit $cmdstatus
    fi
else
    echo "⚠️  Warning: git-secrets が未インストールのため、機密情報チェックをスキップしました。"
    echo "   brew install git-secrets での導入を推奨します。"
fi

# 1-2. gitleaks を実行（ステージ済みの変更のみ検査）
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --staged --redact --no-banner
    cmdstatus=$?
    if [ $cmdstatus -ne 0 ]; then
        echo "❌ gitleaks が機密情報の可能性を検出しました。誤検知なら行末に gitleaks:allow を付けるか .gitleaksignore に登録してください。"
        exit $cmdstatus
    fi
else
    echo "⚠️  Warning: gitleaks が未インストールのため、gitleaksチェックをスキップしました。"
    echo "   mise install での導入を推奨します（Mac/Linux/WSL共通）。"
fi

# 2. localリポジトリのgit-hooksも実行されるようにする
GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
HOOK_NAME=$(basename "$0")
LOCAL_HOOK="${GIT_ROOT}/.git/hooks/${HOOK_NAME}"

# グローバル自身を無限ループで呼び出さないよう、パスが異なるかチェック
# かつ、ローカルフックが存在して実行可能か確認
if [ -f "$LOCAL_HOOK" ] && [ -x "$LOCAL_HOOK" ]; then
    echo "executing local hook: ${LOCAL_HOOK}"
    # 新しいプロセスとして実行（グローバル側の変数汚染を防ぐため）
    "$LOCAL_HOOK" "$@"
    exit_status=$?
    if [ $exit_status -ne 0 ]; then
        exit $exit_status
    fi
fi
